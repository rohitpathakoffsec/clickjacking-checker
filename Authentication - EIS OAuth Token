                      "",
                      "// =============================================",
                      "// PENETRATION TESTING TEST CASES",
                      "// Authentication - EIS OAuth Token",
                      "// =============================================",
                      "",
                      "// 1. Security Headers Check",
                      "pm.test(\"[PenTest] X-Content-Type-Options header is present\", function () {",
                      "    pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.not.be.undefined;",
                      "});",
                      "",
                      "pm.test(\"[PenTest] X-Frame-Options header is present\", function () {",
                      "    pm.expect(pm.response.headers.get(\"X-Frame-Options\")).to.not.be.undefined;",
                      "});",
                      "",
                      "pm.test(\"[PenTest] Strict-Transport-Security (HSTS) header is present\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Strict-Transport-Security\")).to.not.be.undefined;",
                      "});",
                      "",
                      "pm.test(\"[PenTest] X-XSS-Protection header is present\", function () {",
                      "    pm.expect(pm.response.headers.get(\"X-XSS-Protection\")).to.not.be.undefined;",
                      "});",
                      "",
                      "pm.test(\"[PenTest] Content-Security-Policy header is present\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Security-Policy\")).to.not.be.undefined;",
                      "});",
                      "",
                      "// 2. Server Information Disclosure",
                      "pm.test(\"[PenTest] Server header does not expose version info\", function () {",
                      "    const serverHeader = pm.response.headers.get(\"Server\");",
                      "    if (serverHeader) {",
                      "        pm.expect(serverHeader).to.not.match(/\\d+\\.\\d+/); // No version numbers",
                      "    } else {",
                      "        pm.expect(true).to.be.true; // No Server header is acceptable",
                      "    }",
                      "});",
                      "",
                      "pm.test(\"[PenTest] X-Powered-By header is not present (info disclosure)\", function () {",
                      "    pm.expect(pm.response.headers.get(\"X-Powered-By\")).to.be.undefined;",
                      "});",
                      "",
                      "// 3. Response Time (DoS Indicator)",
                      "pm.test(\"[PenTest] Response time is under 5000ms (DoS indicator check)\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                      "});",
                      "",
                      "// 4. Content-Type Validation",
                      "pm.test(\"[PenTest] Response Content-Type is application/json\", function () {",
                      "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                      "});",
                      "",
                      "// 5. Token Structure Validation (on success)",
                      "if (pm.response.code === 200) {",
                      "    pm.test(\"[PenTest] Response contains access_token field\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData).to.have.property(\"access_token\");",
                      "        pm.expect(jsonData.access_token).to.not.be.empty;",
                      "    });",
                      "",
                      "    pm.test(\"[PenTest] Response contains token_type field\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData).to.have.property(\"token_type\");",
                      "    });",
                      "",
                      "    pm.test(\"[PenTest] Response contains expires_in field\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData).to.have.property(\"expires_in\");",
                      "    });",
                      "",
                      "    pm.test(\"[PenTest] Access token is not suspiciously short (< 10 chars)\", function () {",
                      "        const jsonData = pm.response.json();",
                      "        pm.expect(jsonData.access_token.length).to.be.above(10);",
                      "    });",
                      "}",
                      "",
                      "// 6. Error Message Information Disclosure (on failure)",
                      "if (pm.response.code !== 200) {",
                      "    pm.test(\"[PenTest] Error response does not contain stack trace or internal info\", function () {",
                      "        const responseText = pm.response.text().toLowerCase();",
                      "        pm.expect(responseText).to.not.include(\"exception\");",
                      "        pm.expect(responseText).to.not.include(\"stack trace\");",
                      "        pm.expect(responseText).to.not.include(\"at com.\");",
                      "        pm.expect(responseText).to.not.include(\"at org.\");",
                      "        pm.expect(responseText).to.not.include(\"sql\");",
                      "        pm.expect(responseText).to.not.include(\"internal server\");",
                      "    });",
                      "",
                      "    pm.test(\"[PenTest] Error response does not expose internal file paths\", function () {",
                      "        const responseText = pm.response.text();",
                      "        pm.expect(responseText).to.not.match(/[A-Za-z]:\\\\|\\/var\\/|\\/usr\\/|\\/home\\//);",
                      "    });",
                      "}",
                      "",
                      "// 7. Credential Exposure in URL",
                      "pm.test(\"[PenTest] client_id is NOT exposed in the request URL\", function () {",
                      "    const url = pm.request.url.toString();",
                      "    pm.expect(url).to.not.include(\"client_id\");",
                      "});",
                      "",
                      "pm.test(\"[PenTest] client_secret is NOT exposed in the request URL\", function () {",
                      "    const url = pm.request.url.toString();",
                      "    pm.expect(url).to.not.include(\"client_secret\");",
                      "});",
                      "",
                      "// 8. HTTPS Enforcement Check",
                      "pm.test(\"[PenTest] Request URL uses HTTPS (not HTTP)\", function () {",
                      "    const url = pm.request.url.toString();",
                      "    // Allow {{baseUrl}} variable - check if resolved URL starts with https or uses a variable",
                      "    if (!url.includes(\"{{\") && !url.includes(\"{{baseUrl}}\")) {",
                      "        pm.expect(url.toLowerCase()).to.match(/^https:\\/\\//);",
                      "    } else {",
                      "        // Variable used - pass with a note",
                      "        pm.expect(true).to.be.true; // Ensure baseUrl environment variable is set to HTTPS",
                      "    }",
                      "});",
                      "",
                      "// 9. Response Does Not Echo Back Credentials",
                      "pm.test(\"[PenTest] Response body does not echo back client_secret\", function () {",
                      "    const responseText = pm.response.text();",
                      "    const clientSecret = pm.request.body.urlencoded.get(\"client_secret\");",
                      "    if (clientSecret && clientSecret !== \"your_client_secret_here\") {",
                      "        pm.expect(responseText).to.not.include(clientSecret);",
                      "    } else {",
                      "        pm.expect(true).to.be.true;",
                      "    }",
                      "});",
                      "",
                      "// 10. HTTP Status Code is not 500 (Internal Server Error)",
                      "pm.test(\"[PenTest] Response is not a 500 Internal Server Error\", function () {",
                      "    pm.expect(pm.response.code).to.not.equal(500);",
                      "});",
                      ""
                    ]
                  }
                }
